# ============================================
# GovChat - Production Environment Variables
# ============================================
#
# IMPORTANTE: Este arquivo contém configurações sensíveis.
# - NÃO commite este arquivo no Git (.gitignore)
# - Mantenha backup seguro destas configurações
# - Use valores diferentes para cada ambiente (dev/staging/prod)
#

# ============================================
# SUPABASE CONFIGURATION (OBRIGATÓRIO)
# ============================================
# Obtenha estas informações no dashboard do Supabase:
# https://app.supabase.com/project/SEU_PROJECT_ID/settings/api

# URL do projeto Supabase
VITE_SUPABASE_URL="https://seu-projeto-id.supabase.co"

# Chave pública (anon/publishable key) - segura para expor no frontend
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ID do projeto Supabase
VITE_SUPABASE_PROJECT_ID="seu-projeto-id"

# ============================================
# AI PROVIDER CONFIGURATION (OPCIONAL)
# ============================================
# Para usar o chatbot com IA, você precisa de uma chave API

# Lovable AI Gateway (recomendado para Gemini)
# Obtenha em: https://lovable.dev/settings/api-keys
LOVABLE_API_KEY="lovable_sk_..."

# Ou configure diretamente uma chave Google AI (alternativa)
# GOOGLE_AI_API_KEY="AIza..."

# ============================================
# APPLICATION SETTINGS
# ============================================

# Ambiente de execução
NODE_ENV="production"

# URL base da aplicação (usado para redirects de email)
VITE_APP_URL="https://seu-dominio.gov.br"

# Nome da aplicação (opcional)
VITE_APP_NAME="GovChat"

# ============================================
# INTEGRATIONS (OPCIONAL)
# ============================================

# WhatsApp Business API (se usar)
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
# WHATSAPP_ACCESS_TOKEN="seu_token_aqui"
# WHATSAPP_PHONE_NUMBER_ID="seu_phone_id"

# NotificaMeHub (sistema de notificações)
# NOTIFICAMEHUB_API_KEY="sua_chave_aqui"

# ============================================
# MONITORING & ANALYTICS (OPCIONAL)
# ============================================

# Sentry (error tracking)
# VITE_SENTRY_DSN="https://xxx@sentry.io/xxx"

# Google Analytics
# VITE_GA_TRACKING_ID="G-XXXXXXXXXX"

# ============================================
# DEPLOYMENT INFO
# ============================================
# Estas variáveis são informativas e não afetam a aplicação

# Data do último deploy
DEPLOY_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Versão da aplicação (do package.json ou Git tag)
# APP_VERSION="1.0.0"

# Commit hash (gerado automaticamente)
# GIT_COMMIT="$(git rev-parse HEAD)"

# ============================================
# SECURITY NOTES
# ============================================
#
# 1. VARIÁVEIS VITE_* são embutidas no build e VISÍVEIS no browser
#    - Nunca coloque chaves secretas em variáveis VITE_*
#    - Use apenas para URLs públicas e chaves anon do Supabase
#
# 2. Chaves secretas devem ficar apenas nas Edge Functions do Supabase
#    - Configure no dashboard: Project > Edge Functions > Secrets
#    - Nunca exponha no frontend
#
# 3. Row Level Security (RLS) do Supabase protege os dados
#    - Mesmo com a chave anon, dados estão protegidos por RLS
#
# 4. Rotacione chaves regularmente
#    - Especialmente em caso de vazamento
#    - Atualize também no Supabase
#
# ============================================

# Fim do arquivo .env
